# Runs yard_presence_night_off.py as a systemd service for the selected user,
# assuming the script is installed at /home/pi/automations/yard_presence_night_off.py.
[Unit]
Description=Yard night presence off automation for pi
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/automations
ExecStart=/usr/bin/python3 /home/pi/automations/yard_presence_night_off.py
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
