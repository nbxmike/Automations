# Runs late_arrival_override.py as a systemd service for the selected user,
# assuming the script is installed at /home/pi/automations/late_arrival_override.py.
[Unit]
Description=Late arrival override virtual MQTT device for pi
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/automations
ExecStart=/usr/bin/python3 /home/pi/automations/late_arrival_override.py
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
