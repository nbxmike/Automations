# Runs kitchen_early_morning_on.py as a systemd service for the selected user,
# assuming the script is installed at /home/pi/automations/kitchen_early_morning_on.py.
[Unit]
Description=Kitchen early morning presence automation for pi
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/automations
ExecStart=/usr/bin/python3 /home/pi/automations/kitchen_early_morning_on.py
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
