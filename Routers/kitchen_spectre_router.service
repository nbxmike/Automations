# Runs kitchen_spectre_router.py as a systemd service for the selected user,
# assuming the script is installed at /home/pi/automations/Routers/kitchen_spectre_router.py.
[Unit]
Description=Kitchen spectre MQTT command router for pi
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/automations
ExecStart=/usr/bin/python3 /home/pi/automations/Routers/kitchen_spectre_router.py
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pi/automations

[Install]
WantedBy=multi-user.target
